{
  "description": "template pipeline gate",
  "source_base64": "",
  "value": {
    "rulebook_id": "pipeline-gate",
    "version": "1.0.0",
    "adopted_at": "2026-08-05T00:00:00Z",
    "description": "Gate a deployment on declared branch and fresh test evidence.",
    "track": [
      "branch"
    ],
    "evidence": [
      {
        "id": "tests",
        "source": "exec",
        "ref": "./ci/last-test-result.sh",
        "max_age_seconds": 900
      }
    ],
    "rules": [
      {
        "id": "tests-green-on-main",
        "when": "identity.branch == \"main\" and fresh(tests) and evidence.tests == \"passed\"",
        "outcome": "ALLOW",
        "reason": "Tests green on main within freshness bound."
      },
      {
        "id": "tests-red",
        "when": "fresh(tests) and evidence.tests == \"failed\"",
        "outcome": "BLOCK",
        "reason": "Tests failed."
      },
      {
        "id": "wrong-branch",
        "when": "identity.branch != \"main\"",
        "outcome": "BLOCK",
        "reason": "Deploys only from main."
      }
    ],
    "default_outcome": "HOLD",
    "authorization": {
      "ttl_seconds": 300,
      "single_use": true
    }
  },
  "canonical": "{\"adopted_at\":\"2026-08-05T00:00:00Z\",\"authorization\":{\"single_use\":true,\"ttl_seconds\":300},\"default_outcome\":\"HOLD\",\"description\":\"Gate a deployment on declared branch and fresh test evidence.\",\"evidence\":[{\"id\":\"tests\",\"max_age_seconds\":900,\"ref\":\"./ci/last-test-result.sh\",\"source\":\"exec\"}],\"rulebook_id\":\"pipeline-gate\",\"rules\":[{\"id\":\"tests-green-on-main\",\"outcome\":\"ALLOW\",\"reason\":\"Tests green on main within freshness bound.\",\"when\":\"identity.branch == \\\"main\\\" and fresh(tests) and evidence.tests == \\\"passed\\\"\"},{\"id\":\"tests-red\",\"outcome\":\"BLOCK\",\"reason\":\"Tests failed.\",\"when\":\"fresh(tests) and evidence.tests == \\\"failed\\\"\"},{\"id\":\"wrong-branch\",\"outcome\":\"BLOCK\",\"reason\":\"Deploys only from main.\",\"when\":\"identity.branch != \\\"main\\\"\"}],\"track\":[\"branch\"],\"version\":\"1.0.0\"}",
  "sha256": "eb851f1c213105876977484d3f41cd724811819fc65044a0c87cd29c829570ee",
