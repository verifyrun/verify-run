{"adopted_at":"2026-08-05T00:00:00Z","authorization":{"single_use":true,"ttl_seconds":300},"default_outcome":"HOLD","description":"Gate a deployment on declared branch and fresh test evidence.","evidence":[{"id":"tests","max_age_seconds":900,"ref":"./ci/last-test-result.sh","source":"exec"}],"rulebook_id":"pipeline-gate","rules":[{"id":"tests-green-on-main","outcome":"ALLOW","reason":"Tests green on main within freshness bound.","when":"identity.branch == \"main\" and fresh(tests) and evidence.tests == \"passed\""},{"id":"tests-red","outcome":"BLOCK","reason":"Tests failed.","when":"fresh(tests) and evidence.tests == \"failed\""},{"id":"wrong-branch","outcome":"BLOCK","reason":"Deploys only from main.","when":"identity.branch != \"main\""}],"track":["branch"],"version":"1.0.0"}