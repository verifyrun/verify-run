{"adopted_at":"2026-08-05T00:00:00Z","authorization":{"single_use":true,"ttl_seconds":120},"default_outcome":"HOLD","description":"Gate an AI agent's tool calls and shell commands.","evidence":[{"id":"approvals","max_age_seconds":86400,"ref":".vfy/approvals.json","required":false,"source":"file"}],"rulebook_id":"agent-guard","rules":[{"id":"no-destructive-shell","outcome":"BLOCK","reason":"Destructive shell commands are never allowed.","when":"candidate.action.argv[0] in [\"rm\",\"mkfs\",\"dd\",\"shutdown\"] or matches(candidate.action.summary, \"*rm -rf*\")"},{"id":"write-inside-workspace","outcome":"ALLOW","reason":"Writes inside the declared workspace are allowed.","when":"candidate.kind == \"tool_call\" and candidate.action.tool == \"write_file\" and matches(candidate.action.params.path, \"./workspace/*\")"},{"id":"outbound-email-needs-approval","outcome":"HOLD","reason":"External email requires a recorded human approval.","when":"candidate.action.tool == \"send_email\" and not present(approvals)"},{"id":"undeclared-network","outcome":"BLOCK","reason":"Only declared network destinations are allowed.","when":"candidate.kind == \"http_request\" and not matches(candidate.action.targets[0], \"https://api.internal.example/*\")"}],"track":["workspace"],"version":"1.0.0"}